{
  "version": 1,
  "updated": "2026-09-29",
  "presets": [
    {
      "id": "atlassian-rovo-remote",
      "name": "Atlassian Rovo (Official, OAuth)",
      "provider": "Atlassian",
      "category": "project-management",
      "description": "Official Atlassian remote MCP server for Jira, Confluence, JSM, Bitbucket and Compass Cloud via OAuth, bridged locally with mcp-remote.",
      "homepage": "https://github.com/atlassian/atlassian-mcp-server",
      "runtime": "node",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v2/mcp"
      ],
      "fields": [],
      "notes": "Cloud only. First start opens a browser on this Mac for Atlassian OAuth; tokens are cached in ~/.mcp-auth. The legacy /v1/sse endpoint was retired after 2026-06-30.",
      "verifiedSource": "https://github.com/atlassian/atlassian-mcp-server"
    },
    {
      "id": "atlassian-cloud",
      "name": "Jira + Confluence (Cloud, API token)",
      "provider": "Atlassian",
      "category": "project-management",
      "description": "Community mcp-atlassian server for Atlassian Cloud Jira and Confluence using email + API token.",
      "homepage": "https://github.com/sooperset/mcp-atlassian",
      "runtime": "python",
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "{{jiraUrl}}",
        "JIRA_USERNAME": "{{email}}",
        "JIRA_API_TOKEN": "{{apiToken}}",
        "CONFLUENCE_URL": "{{confluenceUrl}}",
        "CONFLUENCE_USERNAME": "{{email}}",
        "CONFLUENCE_API_TOKEN": "{{apiToken}}",
        "READ_ONLY_MODE": "{{readOnly}}",
        "JIRA_PROJECTS_FILTER": "{{jiraProjectsFilter}}",
        "CONFLUENCE_SPACES_FILTER": "{{confluenceSpacesFilter}}"
      },
      "fields": [
        {
          "key": "jiraUrl",
          "label": "Jira URL",
          "type": "url",
          "required": true,
          "placeholder": "https://your-company.atlassian.net"
        },
        {
          "key": "confluenceUrl",
          "label": "Confluence URL",
          "type": "url",
          "placeholder": "https://your-company.atlassian.net/wiki",
          "help": "Usually your site + /wiki. Leave blank to disable Confluence."
        },
        {
          "key": "email",
          "label": "Account email",
          "type": "text",
          "required": true,
          "placeholder": "you@example.com"
        },
        {
          "key": "apiToken",
          "label": "API token",
          "type": "secret",
          "required": true,
          "help": "Create at https://id.atlassian.com/manage-profile/security/api-tokens"
        },
        {
          "key": "readOnly",
          "label": "Read-only mode",
          "type": "boolean",
          "default": true,
          "help": "Disables all write/create/update tools."
        },
        {
          "key": "jiraProjectsFilter",
          "label": "Jira projects filter",
          "type": "text",
          "placeholder": "PROJ,OPS",
          "help": "Optional comma-separated project keys."
        },
        {
          "key": "confluenceSpacesFilter",
          "label": "Confluence spaces filter",
          "type": "text",
          "placeholder": "DEV,DOC",
          "help": "Optional comma-separated space keys."
        }
      ],
      "notes": "The same API token works for Jira and Confluence Cloud. ENABLED_TOOLS / TOOLSETS env vars allow finer tool control.",
      "verifiedSource": "https://raw.githubusercontent.com/sooperset/mcp-atlassian/main/.env.example"
    },
    {
      "id": "jira-server",
      "name": "Jira (Server / Data Center, PAT)",
      "provider": "Atlassian",
      "category": "project-management",
      "description": "mcp-atlassian server for self-hosted Jira Server/Data Center using a Personal Access Token.",
      "homepage": "https://github.com/sooperset/mcp-atlassian",
      "runtime": "python",
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "{{jiraUrl}}",
        "JIRA_PERSONAL_TOKEN": "{{personalToken}}",
        "JIRA_SSL_VERIFY": "{{sslVerify}}",
        "READ_ONLY_MODE": "{{readOnly}}",
        "JIRA_PROJECTS_FILTER": "{{jiraProjectsFilter}}"
      },
      "fields": [
        {
          "key": "jiraUrl",
          "label": "Jira base URL",
          "type": "url",
          "required": true,
          "placeholder": "https://jira.your-company.com"
        },
        {
          "key": "personalToken",
          "label": "Personal Access Token",
          "type": "secret",
          "required": true,
          "help": "Jira profile > Personal Access Tokens (Server/DC 8.14+)."
        },
        {
          "key": "sslVerify",
          "label": "Verify SSL certificate",
          "type": "boolean",
          "default": true,
          "help": "Turn off only for self-signed certificates on internal hosts."
        },
        {
          "key": "readOnly",
          "label": "Read-only mode",
          "type": "boolean",
          "default": true
        },
        {
          "key": "jiraProjectsFilter",
          "label": "Jira projects filter",
          "type": "text",
          "placeholder": "PROJ,OPS",
          "help": "Optional comma-separated project keys."
        }
      ],
      "notes": "Server/DC uses JIRA_PERSONAL_TOKEN instead of username + API token.",
      "verifiedSource": "https://raw.githubusercontent.com/sooperset/mcp-atlassian/main/.env.example"
    },
    {
      "id": "confluence-server",
