      ],
      "env": {
        "CONFLUENCE_URL": "{{confluenceUrl}}",
        "CONFLUENCE_PERSONAL_TOKEN": "{{personalToken}}",
        "CONFLUENCE_SSL_VERIFY": "{{sslVerify}}",
        "READ_ONLY_MODE": "{{readOnly}}",
        "CONFLUENCE_SPACES_FILTER": "{{confluenceSpacesFilter}}"
      },
      "fields": [
        {
          "key": "confluenceUrl",
          "label": "Confluence base URL",
          "type": "url",
          "required": true,
          "placeholder": "https://confluence.your-company.com"
        },
        {
          "key": "personalToken",
          "label": "Personal Access Token",
          "type": "secret",
          "required": true,
          "help": "Confluence profile > Personal Access Tokens."
        },
        {
          "key": "sslVerify",
          "label": "Verify SSL certificate",
          "type": "boolean",
          "default": true
        },
        {
          "key": "readOnly",
          "label": "Read-only mode",
          "type": "boolean",
          "default": true
        },
        {
          "key": "confluenceSpacesFilter",
          "label": "Confluence spaces filter",
          "type": "text",
          "placeholder": "DEV,DOC",
          "help": "Optional comma-separated space keys."
        }
      ],
      "notes": "For Data Center the URL usually has no /wiki suffix.",
      "verifiedSource": "https://raw.githubusercontent.com/sooperset/mcp-atlassian/main/.env.example"
    },
    {
      "id": "github-remote",
      "name": "GitHub (Official Remote)",
      "provider": "GitHub",
      "category": "code",
      "description": "GitHub's hosted MCP server over HTTP, authenticated with a Personal Access Token.",
      "homepage": "https://github.com/github/github-mcp-server",
      "runtime": "remote",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{token}}",
        "X-MCP-Readonly": "{{readOnly}}",
        "X-MCP-Toolsets": "{{toolsets}}"
      },
      "fields": [
        {
          "key": "token",
          "label": "GitHub PAT",
          "type": "secret",
          "required": true,
          "help": "Fine-grained or classic PAT: https://github.com/settings/personal-access-tokens"
        },
        {
          "key": "readOnly",
          "label": "Read-only mode",
          "type": "boolean",
          "default": true,
          "help": "Sent as the X-MCP-Readonly header."
        },
        {
          "key": "toolsets",
          "label": "Toolsets",
          "type": "text",
          "placeholder": "repos,issues,pull_requests",
          "help": "Optional comma-separated toolsets; blank = defaults."
        }
      ],
      "verifiedSource": "https://raw.githubusercontent.com/github/github-mcp-server/main/docs/remote-server.md"
    },
    {
      "id": "github-local",
      "name": "GitHub (Local, Docker)",
      "provider": "GitHub",
      "category": "code",
      "description": "GitHub's official MCP server in Docker; supports GitHub.com and GitHub Enterprise Server.",
      "homepage": "https://github.com/github/github-mcp-server",
      "runtime": "docker",
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        {
          "when": "toolsets",
          "args": [
            "-e",
            "GITHUB_TOOLSETS"
          ]
        },
        {
          "when": "readOnly",
          "args": [
            "-e",
            "GITHUB_READ_ONLY"
          ]
        },
        {
          "when": "githubHost",
          "args": [
            "-e",
            "GITHUB_HOST"
          ]
        },
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{token}}",
        "GITHUB_TOOLSETS": "{{toolsets}}",
        "GITHUB_READ_ONLY": "1",
        "GITHUB_HOST": "{{githubHost}}"
      },
      "fields": [
        {
          "key": "token",
          "label": "GitHub PAT",
          "type": "secret",
          "required": true,
          "help": "https://github.com/settings/personal-access-tokens"
        },
        {
          "key": "toolsets",
          "label": "Toolsets",
          "type": "text",
          "placeholder": "repos,issues,pull_requests",
          "help": "Optional comma-separated toolsets; blank = defaults."
        },
        {
          "key": "readOnly",
          "label": "Read-only mode",
          "type": "boolean",
          "default": true
        },
        {
          "key": "githubHost",
          "label": "GitHub Enterprise host",
          "type": "url",
          "placeholder": "https://ghe.your-company.com",
          "help": "Only for GitHub Enterprise Server."
        }
      ],
      "notes": "Requires Docker Desktop running.",
      "verifiedSource": "https://github.com/github/github-mcp-server"
    },
    {
      "id": "gitlab",
      "name": "GitLab (gitlab.com / self-managed)",
      "provider": "GitLab",
      "category": "code",
      "description": "Community GitLab MCP server (@zereight/mcp-gitlab) for gitlab.com and self-managed instances.",
      "homepage": "https://github.com/zereight/gitlab-mcp",
      "runtime": "node",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab@latest"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "{{token}}",
        "GITLAB_API_URL": "{{apiUrl}}",
        "GITLAB_PERMISSION_MODE": "{{permissionMode}}"
      },
      "fields": [
        {
          "key": "token",
          "label": "Personal Access Token",
          "type": "secret",
          "required": true,
          "help": "<instance>/-/user_settings/personal_access_tokens (scope: api or read_api)."
        },
        {
          "key": "apiUrl",
          "label": "GitLab API URL",
          "type": "url",
          "required": true,
          "default": "https://gitlab.com/api/v4",
          "placeholder": "https://gitlab.your-company.com/api/v4",
          "help": "Instance URL + /api/v4."
        },
        {
          "key": "permissionMode",
          "label": "Permission mode",
          "type": "select",
          "options": [
            "readonly",
            "modify",
            "full"
          ],
          "default": "readonly",
          "help": "readonly hides every mutating tool."
        }
      ],
      "notes": "GITLAB_PERMISSION_MODE replaces the older GITLAB_READ_ONLY_MODE. GitLab 18.6+ also ships a built-in MCP endpoint on the instance itself.",
      "verifiedSource": "https://github.com/zereight/gitlab-mcp"
    },
    {
      "id": "playwright",
      "name": "Playwright",
      "provider": "Microsoft",
      "category": "browser",
      "description": "Official Playwright MCP server for browser automation.",
      "homepage": "https://github.com/microsoft/playwright-mcp",
      "runtime": "node",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        {
          "when": "browser",
          "args": [
            "--browser",
            "{{browser}}"
          ]
        },
        {
          "when": "headless",
          "args": [
            "--headless"
          ]
        },
        {
          "when": "isolated",
          "args": [
            "--isolated"
          ]
        }
      ],
      "fields": [
        {
          "key": "browser",
          "label": "Browser",
          "type": "select",
          "options": [
            "chrome",
            "msedge",
            "firefox",
            "webkit"
          ],
          "default": "chrome"
        },
        {
          "key": "headless",
          "label": "Headless",
          "type": "boolean",
          "default": true,
          "help": "Recommended when the hub runs in the background."
        },
        {
          "key": "isolated",
          "label": "Isolated profile",
          "type": "boolean",
          "default": true,
          "help": "Keep the browser profile in memory."
        }
      ],
      "notes": "One shared browser serves every client session. Extra capabilities via --caps (vision, pdf, devtools).",
      "verifiedSource": "https://registry.npmjs.org/@playwright/mcp/latest"
    },
